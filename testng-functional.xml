<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="functional">
    <listeners>
        <listener class-name="config.TestLoggerListener"/>
    </listeners>

    <test name="ui">
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        
        <packages>
            <package name="ui.tests"/>
        </packages>
    </test>

    <test name="api">
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        
        <packages>
            <package name="api.tests"/>
        </packages>
    </test>
</suite>