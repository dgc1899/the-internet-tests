    {
      "name": "POST booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Test POST booking with valid data returns 200\", function() {",
              "    pm.expect(pm.response.code).to.be.equals(200);",
              "}",
              ");",
              "",
              "pm.test(\"Test POST booking with valid data returns message with data\", function() {",
              "   pm.expect(jsonData.bookingid).to.be.a(\"number\");",
              "   pm.expect(jsonData.bookingid).to.be.above(0);",
              "",
              "   pm.expect(jsonData.booking.firstname).to.be.eql(\"Daniel\");",
              "   pm.expect(jsonData.booking.lastname).to.be.eql(\"Garcia\");",
              "   pm.expect(jsonData.booking.totalprice).to.be.eql(150);",
              "   pm.expect(jsonData.booking.totalprice).to.be.eql(150);",
              "   pm.expect(jsonData.booking.depositpaid).to.be.eql(true);",
              "   pm.expect(jsonData.booking.bookingdates.checkin).to.be.eql(\"2026-03-02\");",
              "   pm.expect(jsonData.booking.bookingdates.checkout).to.be.eql(\"2026-04-02\");",
              "   pm.expect(jsonData.booking.additionalneeds).to.be.eql(\"None\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\": \"Daniel\",\n    \"lastname\": \"Garcia\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-03-02\",\n        \"checkout\": \"2026-04-02\"\n    },\n    \"additionalneeds\": \"None\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
